# Copia este archivo como .env y llena los valores. NUNCA compartas el .env.

# SerpApi (serpapi.com -> Dashboard -> API Key)
SERPAPI_KEY=

# Identificador del restaurante en Google Maps. Usa uno de los dos.
# Sácalo con: python3 agent.py --find-place "The Oyster Shack Condado San Juan"
GOOGLE_DATA_ID=
GOOGLE_PLACE_ID=

# Anthropic (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Email: sale de info@ y llega a Joseph
EMAIL_FROM=info@theoystershackpr.com
EMAIL_TO=josephrodz.ai@gmail.com
# Contraseña de aplicación de Google para info@ (no la contraseña normal)
SMTP_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Ajustes
LOOKBACK_HOURS=48
MAX_PAGES=3
SEND_WHEN_EMPTY=true

# WhatsApp por OpenClaw (Juniorkilla). Número en formato +1787XXXXXXX (el tuyo, a donde llega el aviso)
WHATSAPP_TO=
# Ruta completa de la CLI (sale con: which openclaw). Hace falta porque launchd no carga tu PATH.
OPENCLAW_BIN=
# Opcional: cuenta de WhatsApp de OpenClaw si tienes más de una
OPENCLAW_ACCOUNT=
WHATSAPP_NOTIFY=true
# true = avisa aunque no haya reviews nuevos
WHATSAPP_WHEN_EMPTY=false
# Páginas que revisa --backfill-mentions
BACKFILL_PAGES=15
