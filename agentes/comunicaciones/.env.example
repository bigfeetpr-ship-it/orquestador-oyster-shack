# Copia como .env. Si ANTHROPIC_API_KEY queda vacío, se usa la del agente de reviews (../reviews-google/.env).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Endpoint de ingesta del Shack Staff Hub (Lovable): https://<proyecto>.supabase.co/functions/v1/ingesta
HUB_INGEST_URL=
# El mismo valor que el secret INGEST_TOKEN en Lovable. Generarlo con: openssl rand -hex 24
HUB_INGEST_TOKEN=
